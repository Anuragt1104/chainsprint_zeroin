{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "headers": [
    {
      "source": "/api/webhooks/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, x-zerion-signature, x-zerion-timestamp"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/webhooks/zerion",
      "destination": "/api/webhooks/zerion"
    }
  ]
}

